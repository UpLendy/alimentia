# URL base del backend (Elysia + Bun, repo plataforma_documentos_backend),
# sin slash final. Usada tanto en el cliente (src/lib/api.ts, llamadas
# autenticadas con Bearer token) como en las Route Handlers de
# /api/auth/{login,refresh,logout} (proxy server-to-server hacia Alimentia).
#
# - Desarrollo local: http://localhost:3001
# - Producción (Vercel): URL pública del backend en EC2. Pendiente hasta que
#   se despliegue esa instancia; configurar en Vercel > Project Settings >
#   Environment Variables una vez exista (ej. https://api.alimentia.co).
NEXT_PUBLIC_API_URL=http://localhost:3001
